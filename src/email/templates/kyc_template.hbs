<div style="font-family: Arial, sans-serif;">
  <h2>Hello Team 👋</h2>

  <p>
    A new KYC submission has been received for
    <strong>{{service_name}}</strong>.
  </p>

  <h3 style="margin-top: 24px;">Company Details</h3>

  <p><strong>Company Name:</strong> {{company_name}}</p>
  <p><strong>CIN:</strong> {{cin}}</p>
  <p>
    <strong>Date of Incorporation:</strong>
    {{date_of_incorporation}}
  </p>
  <p><strong>PAN:</strong> {{pan}}</p>
  <p><strong>GSTIN:</strong> {{gstin}}</p>
  <p>
    <strong>Nature of Business:</strong>
    {{nature_of_business}}
  </p>

  <h3 style="margin-top: 24px;">Addresses</h3>

  <p>
    <strong>Registered Office Address:</strong><br />
    {{registered_office_address}}
  </p>

  <p>
    <strong>Business Address(es):</strong><br />
    {{business_addresses}}
  </p>

  <h3 style="margin-top: 24px;">Contact Details</h3>

  <p>
    <strong>Contact Person Name:</strong>
    {{contact_person_name}}
  </p>

  <p>
    <strong>Contact Email:</strong>
    {{contact_email}}
  </p>

  <p>
    <strong>Contact Number:</strong>
    {{contact_number}}
  </p>

  <h3 style="margin-top: 24px;">Uploaded Documents</h3>

  <p>
    <strong>PAN Uploads:</strong><br />
    {{{pan_upload_links}}}
  </p>

  <p>
    <strong>GST Uploads:</strong><br />
    {{{gst_upload_links}}}
  </p>

  <p>
    <strong>Signed NDA:</strong><br />
    {{{signed_nda_links}}}
  </p>

  <p>
    <strong>Signed Engagement Letter:</strong><br />
    {{{signed_engagement_letter_links}}}
  </p>

  <p style="margin-top: 30px;">
    Thanks,<br />
    Team
  </p>
</div>